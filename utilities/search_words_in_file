#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
    echo "Usage: $0 <file> <word1> [word2 ...]" >&2
    exit 1
fi

FILE="$1"
shift

if [[ ! -f "$FILE" ]]; then
    echo "Error: file not found: $FILE" >&2
    exit 1
fi

echo "Searching words in file: $FILE"

PATTERN=""
for word in "$@"; do
    if [[ -n "$PATTERN" ]]; then
        PATTERN="${PATTERN}|"
    fi
    PATTERN="${PATTERN}${word}"
done

grep -En "$PATTERN" "$FILE"
