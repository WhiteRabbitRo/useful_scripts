#!/usr/bin/env bash
set -euo pipefail

echo "Installing GOST engine for OpenSSL"

pckgs=( git cmake libssl-dev openssl pkg-config )

for package in "${pckgs[@]}"; do
    REQUIRED_PKG="$package"
    PKG_OK=$(dpkg-query -W --showformat='${Status}\n' "$REQUIRED_PKG" | grep "install ok installed" || true)
    echo "Checking for $REQUIRED_PKG: $PKG_OK"
    if [[ "" = "$PKG_OK" ]]; then
        echo "No $REQUIRED_PKG. Setting up $REQUIRED_PKG."
        sudo apt-get --yes install "$REQUIRED_PKG"
    fi
done

OPENSSL_DIR="$(openssl version -d | cut -d '"' -f 2)"
ENGINE_DIR="$(openssl version -e | cut -d '"' -f 2)"
OPENSSL_CNF="${OPENSSL_DIR}/openssl.cnf"

if [[ -f "$OPENSSL_CNF" ]]; then
    cp "$OPENSSL_CNF" "${OPENSSL_CNF}.bak.$(date +%s)"
    echo "Backup created: ${OPENSSL_CNF}.bak.$(date +%s)"
fi

mkdir -p tmp
git clone --recursive https://github.com/gost-engine/engine tmp/engine

mkdir -p tmp/engine/build
cd tmp/engine/build

cmake -DCMAKE_BUILD_TYPE=Release -DOPENSSL_ROOT_DIR="$OPENSSL_DIR" ..
cmake --build . --target install --config Release

cp bin/gost.so "$ENGINE_DIR/"

cat "$OPENSSL_CNF" | sed -e "s/openssl_conf = .*/openssl_conf = openssl_def/" > openssl.cnf
cat >> openssl.cnf <<EOF

[openssl_def]
engines = engine_section

[engine_section]
gost = gost_section

[gost_section]
engine_id = gost
dynamic_path = ${ENGINE_DIR}/gost.so
default_algorithms = ALL
EOF

sudo mv openssl.cnf "$OPENSSL_CNF"

cd ../../..
rm -rf tmp

echo "GOST engine installed."
