#!/usr/bin/env bash
# DEPRECATED: используйте static_analysis/static_analysis.py
# Этот wrapper сохраняет совместимость синтаксиса -i=DIR, -d=DEF, -s=DIR.
set -euo pipefail

echo "[DEPRECATED] secure_developing/static_analysis устарел. Используйте static_analysis/static_analysis.py" >&2

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SA="${SCRIPT_DIR}/../static_analysis/static_analysis.py"

if [[ ! -f "$PYTHON_SA" ]]; then
    echo "Error: Python static analysis not found at $PYTHON_SA" >&2
    exit 1
fi

ARGS=()
for arg in "$@"; do
    case $arg in
        -v|--verbose)
            ARGS+=("-v")
            ;;
        -h|--help)
            ARGS+=("-h")
            ;;
        -i=*|--incdir=*)
            ARGS+=("-i" "${arg#*=}")
            ;;
        -d=*|--define=*)
            ARGS+=("-d" "${arg#*=}")
            ;;
        -s=*|--srcdir=*)
            ARGS+=("-s" "${arg#*=}")
            ;;
        --logdir=*)
            ARGS+=("--logdir" "${arg#*=}")
            ;;
        *)
            echo "Неизвестный аргумент: $arg" >&2
            exit 1
            ;;
    esac
done

exec python3 "$PYTHON_SA" "${ARGS[@]}"
