#!/usr/bin/env bash
set -euo pipefail

echo "Upgrading python tools"

python3 -m pip install --upgrade pip setuptools wheel

which -a python3

python3 -c "import math" && echo $?

pip3 list | grep math || true

PY_VERSION="$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
PIP_TARGET="/usr/local/lib/python${PY_VERSION}/site-packages"

mkdir -p ~/.config/pip
cat > ~/.config/pip/pip.conf <<EOF
[global]
target = ${PIP_TARGET}
EOF

export PYTHONPATH="${PYTHONPATH:-}:${PIP_TARGET}"
echo "Configured pip target: ${PIP_TARGET}"
